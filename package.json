{
  "name": "nuxt-time-zone",
  "version": "0.0.1",
  "description": "The visitor's time zone in Nuxt, on the server and the client",
  "keywords": [
    "hydration",
    "nuxt",
    "nuxt-module",
    "ssr",
    "time-zone",
    "timezone"
  ],
  "homepage": "https://github.com/onmax/nuxt-time-zone#readme",
  "bugs": "https://github.com/onmax/nuxt-time-zone/issues",
  "license": "MIT",
  "author": "onmax",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onmax/nuxt-time-zone.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "nuxt-module-build prepare && nuxt-module-build build",
    "prepack": "pnpm build",
    "dev": "nuxi dev playground --port 4320",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p playground && vue-tsc --noEmit -p playground/server",
    "test:e2e": "playwright test",
    "test:e2e:dev": "E2E_DEV=1 playwright test",
    "validate": "pnpm build && publint --strict",
    "build:playground": "nuxi build playground",
    "brand": "node --no-warnings .github/scripts/brand.ts"
  },
  "dependencies": {
    "@nuxt/kit": "catalog:prod",
    "h3": "catalog:prod"
  },
  "devDependencies": {
    "@nuxt/module-builder": "catalog:build",
    "@playwright/test": "catalog:test",
    "@types/node": "catalog:build",
    "nuxt": "catalog:nuxt",
    "publint": "catalog:build",
    "sharp": "catalog:brand",
    "typescript": "catalog:build",
    "vite-doctor": "catalog:lint",
    "vite-plus": "catalog:lint",
    "vue": "catalog:nuxt",
    "vue-router": "catalog:nuxt",
    "vue-tsc": "catalog:build"
  },
  "peerDependencies": {
    "nuxt": ">=4.0.0"
  },
  "packageManager": "pnpm@12.16.1"
}
